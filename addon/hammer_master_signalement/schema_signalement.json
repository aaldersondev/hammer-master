{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signalement en jeu de Hammer Master, format 2 (une ligne de signalements.txt)",
  "type": "object",
  "required": ["format", "n", "quand", "carte", "texte", "pos", "oeil", "angles", "vue", "vise", "normale", "monde", "revision", "revision_source", "bsp", "joueur"],
  "$defs": {
    "v3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  },
  "properties": {
    "format": { "const": 2 },
    "n": { "type": "integer", "minimum": 1 },
    "quand": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" },
    "carte": { "type": "string", "minLength": 1 },
    "texte": { "type": "string", "minLength": 1 },
    "pos": { "$ref": "#/$defs/v3" },
    "oeil": { "$ref": "#/$defs/v3" },
    "angles": { "$ref": "#/$defs/v3", "description": "tangage, lacet, roulis du regard du joueur" },
    "vue": {
      "type": "object",
      "required": ["origine", "angles", "aspect", "ecran"],
      "properties": {
        "origine": { "$ref": "#/$defs/v3" },
        "angles": { "$ref": "#/$defs/v3" },
        "fov": { "type": "number", "description": "champ horizontal de la vue, ajusté au format de l'écran" },
        "fov_reglage": { "type": "number", "description": "champ tel que réglé, base 4/3" },
        "fov_scene": { "type": "number", "description": "champ reçu par GM:RenderScene" },
        "aspect": { "type": "number", "exclusiveMinimum": 0 },
        "ecran": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }
      }
    },
    "vise": { "$ref": "#/$defs/v3" },
    "normale": { "$ref": "#/$defs/v3" },
    "texture": { "type": "string" },
    "monde": { "type": "boolean" },
    "distance": { "type": "number", "minimum": 0 },
    "objet": {
      "type": "object",
      "required": ["classe", "pos"],
      "properties": {
        "classe": { "type": "string" },
        "modele": { "type": "string" },
        "pos": { "$ref": "#/$defs/v3" },
        "angles": { "$ref": "#/$defs/v3" }
      }
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]*$" },
    "revision_source": { "enum": ["bsp", "serveur", ""] },
    "bsp": {
      "type": "object",
      "required": ["fichier", "taille", "date"],
      "properties": {
        "fichier": { "type": "string" },
        "taille": { "type": "integer" },
        "date": { "type": "integer", "description": "secondes depuis 1970 ; 0 si introuvable, 1 pour un contenu du Workshop" }
      }
    },
    "joueur": {
      "type": "object",
      "required": ["noclip", "accroupi", "vehicule", "au_sol", "vue_externe"],
      "additionalProperties": { "type": "boolean" }
    },
    "capture": { "type": "string", "pattern": "^\\d{3,}\\.jpg$" }
  }
}
